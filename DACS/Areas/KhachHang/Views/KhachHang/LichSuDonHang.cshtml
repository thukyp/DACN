@model DACS.Models.ViewModels.OrderHistoryViewModel
@{
    ViewData["Title"] = "Lịch Sử Đơn Hàng";
    // Layout = "_AccountLayout"; // Nếu bạn có layout riêng cho trang tài khoản
}
<div class="container mt-4 account-section">
    @* Added mt-4 for top margin *@
    <div class="row">
        @* Cột Menu bên trái *@
        <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="account-menu list-group shadow-sm">

                @* 1. Tổng quan *@
                <a asp-area="KhachHang" asp-controller="KhachHang" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-tachometer-alt fa-fw me-2"></i> Tổng quan
                </a>

                @* 2. Hồ sơ cá nhân *@
                <a asp-area="KhachHang" asp-controller="KhachHang" asp-action="HoSoCaNhan"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "HoSoCaNhan" ? "active" : "")">
                    <i class="fas fa-user-circle fa-fw me-2"></i> Hồ sơ cá nhân
                </a>

                @* 3. Lịch sử Đơn hàng *@
                <a asp-area="KhachHang" asp-controller="KhachHang" asp-action="LichSuDonHang"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "LichSuDonHang" ? "active" : "")">
                    <i class="fas fa-receipt fa-fw me-2"></i> Lịch sử Đơn hàng
                </a>

                @* 4. Lịch sử Thu gom *@
                <a asp-area="KhachHang" asp-controller="KhachHang" asp-action="LichSuYeuCauThuGom"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "LichSuYeuCauThuGom" ? "active" : "")">
                    <i class="fas fa-recycle fa-fw me-2"></i> Lịch sử Thu gom
                </a>

                @* --- PHẦN ĐÁNH GIÁ (MỚI) --- *@

                @* 5. Chờ đánh giá (Đã sửa lại class cho đẹp) *@
                <a asp-area="KhachHang" asp-controller="KhachHang" asp-action="SanPhamChoDanhGia"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "SanPhamChoDanhGia" ? "active" : "")">
                    <i class="fas fa-star fa-fw me-2 text-warning"></i> Chờ đánh giá
                </a>

                @* 6. Lịch sử đánh giá (THÊM MỚI) *@
                <a asp-area="KhachHang" asp-controller="KhachHang" asp-action="LichSuDanhGia"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "LichSuDanhGia" ? "active" : "")">
                    <i class="fas fa-history fa-fw me-2 text-success"></i> Lịch sử đánh giá
                </a>

                @* --------------------------- *@

                @* 7. Đổi mật khẩu *@
                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword"
                   class="list-group-item list-group-item-action">
                    <i class="fas fa-lock fa-fw me-2"></i> Đổi mật khẩu
                </a>

                @* 8. Đăng xuất / Về trang chủ *@
                <div class="list-group-item p-0">
                    <a href="/home/index" class="btn btn-light w-100 text-start text-danger border-0 rounded-0 py-3 px-3">
                        <i class="fas fa-sign-out-alt fa-fw me-2"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Mã Đơn</th>
                <th scope="col">Ngày Đặt</th>
                <th scope="col" class="text-end">Tổng Tiền</th>
                <th scope="col">Trạng Thái</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Orders.Any())
            {
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><a asp-action="ChiTietDonHang" asp-route-id="@order.OrderId" class="order-id-link">#@order.OrderId</a></td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@order.TotalAmount.ToString("N0") đ</td>
                        <td>
                            @* Dùng if/else hoặc switch để hiển thị badge màu tương ứng với Status *@
                            @if (order.Status == "Đã giao")
                            {
                                <span class="badge bg-success">@order.Status</span>
                            }
                            else if (order.Status == "Đang xử lý")
                            {
                                <span class="badge bg-info text-dark">@order.Status</span>
                            }
                            else if (order.Status == "Đang giao hàng")
                            {
                                <span class="badge bg-primary">@order.Status</span>
                            }
                            else if (order.Status == "Đã hủy")
                            {
                                <span class="badge bg-danger">@order.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.Status</span>
                            }
                        </td>
                        <td><a asp-action="ChiTietDonHang" asp-route-id="@order.OrderId" class="action-link">Xem</a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">Bạn chưa có đơn hàng nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
        </div>
    </div>
</div>
@if (Model.TotalPages > 1)
{
    <nav aria-label="Order history navigation" class="mt-4 d-flex justify-content-center">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="LichSuDonHang"
                   asp-route-page="@(Model.PageIndex - 1)"
                   asp-route-statusFilter="@Model.CurrentStatusFilter"
                   asp-route-timeFilter="@Model.CurrentTimeFilter">Trước</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="LichSuDonHang"
                       asp-route-page="@i"
                       asp-route-statusFilter="@Model.CurrentStatusFilter"
                       asp-route-timeFilter="@Model.CurrentTimeFilter">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="LichSuDonHang"
                   asp-route-page="@(Model.PageIndex + 1)"
                   asp-route-statusFilter="@Model.CurrentStatusFilter"
                   asp-route-timeFilter="@Model.CurrentTimeFilter">Sau</a>
            </li>
        </ul>
    </nav>
   
}