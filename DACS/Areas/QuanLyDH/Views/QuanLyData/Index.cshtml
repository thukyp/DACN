@* Views/QuanLyData/Index.cshtml *@
@{
    ViewData["Title"] = "Quản Lý Dữ Liệu Blockchain";
}

<h2>Khôi Phục Dữ Liệu Đơn Hàng từ Blockchain</h2>

<hr />

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <link rel="stylesheet" href="~/css/AdminLayout.css" />
    <link rel="stylesheet" href="~/css/AdminOrderManagement.css" />
    <style>
        /* CSS cơ bản cho ví dụ này - Bạn nên đưa vào file CSS riêng */
        body, html {
            height: 100%;
        }

        .container {
            display: grid;
            max-width: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            flex-direction: row;
        }

        .container-fluid.d-flex { /* Sửa lại selector cho đúng */
            height: 100%;
            padding: 0; /* Loại bỏ padding nếu sidebar và main-content đã có */
        }

        .sidebar {
            background-color: #212529;
            color: #fff;
            padding: 15px;
            width: 250px;
            flex-shrink: 0;
            min-height: 100vh;
        }

            .sidebar h2 {
                border-bottom: 1px solid #495057;
                padding-bottom: 10px;
                font-size: 1.5rem;
            }

            .sidebar .nav-link {
                color: #adb5bd;
                padding: 8px 15px;
            }

                .sidebar .nav-link.active, .sidebar .nav-link:hover {
                    color: #fff;
                    background-color: #495057;
                    border-radius: 0.25rem;
                }

        .main-content-area {
            padding: 25px;
            background-color: #f8f9fa;
            flex-grow: 1;
            overflow-y: auto;
        }

        .page-header {
            font-size: 1.75rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            color: #343a40;
        }

        .stat-card {
            background-color: #fff;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            text-align: center;
        }

            .stat-card .value {
                font-size: 1.75rem;
                font-weight: 600;
                /* Màu sẽ được set inline hoặc qua class động */
            }

            .stat-card .label {
                font-size: 0.9rem;
                color: #6c757d;
                margin-top: 0.25rem;
            }

        .filter-card {
            background-color: #fff;
            padding: 1rem 1.5rem;
            border-radius: 0.375rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .table-container {
            background-color: #fff;
            padding: 1.5rem;
            border-radius: 0.375rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .table th {
            font-weight: 600;
            background-color: #e9ecef;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .table .actions a, .table .actions button {
            margin-right: 5px;
            margin-bottom: 5px; /* Thêm khoảng cách dưới cho các nút nếu chúng wrap */
            font-size: 0.85rem;
        }

        .table .actions .btn-sm {
            padding: 0.2rem 0.4rem;
        }

        .action-group .btn {
            margin-right: 3px; /* Khoảng cách nhỏ giữa các icon button */
        }

        .table .badge {
            font-size: 0.75rem;
            padding: 0.3em 0.5em;
        }
    </style>
</head>
<body>
    @* Thêm container-fluid để bao bọc sidebar và main content nếu layout của bạn yêu cầu *@
    <div class="container-fluid d-flex p-0">
        <div class="sidebar">
            <h2>Quản lý đơn hàng </h2>
            <ul class="nav flex-column">
                @* Điều chỉnh các asp-controller và asp-action cho phù hợp với cấu trúc của bạn *@
                <li class="nav-item"><a asp-area="QuanLyDH" asp-controller="QuanLyDH" asp-action="Index" class="nav-link active"><i class="fas fa-receipt me-2"></i> Quản lý Đơn Hàng</a></li>
                <li class="nav-item"><a asp-area="QuanLyDH" asp-controller="QuanLyThanhToan" asp-action="Index" class="nav-link"><i class="fas fa-credit-card me-2"></i> Quản lý Thanh Toán</a></li>
                <li class="nav-item"><a asp-area="QuanLyDH" asp-controller="QuanLyData" asp-action="Index" class="nav-link"><i class="fas fa-credit-card me-2"></i> Quản lý Data</a></li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm_sidebar_index" class="mt-3">
                    @* Moved mt-3 to form *@
                    <button type="submit" class="list-group-item list-group-item-action text-danger border-0 bg-transparent p-0 w-100 text-start">
                        @* Adjusted button style to better match list items *@
                        <span class="list-group-item list-group-item-action border-0 text-danger"><i class="fas fa-sign-out-alt fa-fw me-2"></i> Đăng xuất</span>
                    </button>
                </form>
            </ul>
        </div>
        @{
            ViewData["Title"] = "Tra Cứu Lịch Sử Đơn Hàng";
        }

        <div class="container mt-5">
            <h2>Tra Cứu Lịch Sử Đơn Hàng trên Blockchain</h2>
            <hr />

            <form asp-action="TraceOrder" method="post" class="mt-4">
                <div class="form-group">
                    <label for="orderId">Nhập Mã Đơn Hàng (LotId):</label>
                    <input type="text" id="orderId" name="orderId" class="form-control" required />
                    <small class="form-text text-muted">Ví dụ: DH000001</small>
                </div>

                @* Hiển thị lỗi từ ModelState (nếu có) *@
                <div asp-validation-summary="All" class="text-danger"></div>

                <button type="submit" class="btn btn-primary mt-3">
                    <i class="fas fa-search"></i> Tra Cứu
                </button>
            </form>
        </div>
</div>
</body>
</html>